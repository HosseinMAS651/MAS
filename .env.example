# ─────────────────────────────────────────────────────────────
# نمونهٔ تنظیمات محیطی MAS — این فایل را به .env کپی کنید
# همهٔ متغیرها با MAS_ شروع می‌شوند (به‌جز DATABASE_URL).
# ─────────────────────────────────────────────────────────────

# development | test | production
MAS_ENV=development

# در production اجباری است: حداقل ۳۲ کاراکتر تصادفی
# ساختن یک مقدار تصادفی:  python -c "import secrets;print(secrets.token_urlsafe(48))"
MAS_SECRET_KEY=

# ── دیتابیس ─────────────────────────────────────────────────
# در production اجباری است (برنامه با SQLite بالا نمی‌رود تا داده‌ها گم نشوند).
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://mas_user:strong_password@127.0.0.1:5432/mas
# توسعهٔ محلی (اختیاری — پیش‌فرض):
# DATABASE_URL=sqlite:///./mas.db

# ── ذخیره‌سازی فایل‌ها ───────────────────────────────────────
# local | s3
MAS_STORAGE_BACKEND=local
MAS_STORAGE_DIR=./uploads

# فقط برای MAS_STORAGE_BACKEND=s3 (باید requirements-s3.txt نصب شود)
# MAS_S3_ENDPOINT_URL=https://s3.amazonaws.com        # یا R2/آروان‌کلاد/MinIO
# MAS_S3_REGION=us-east-1
# MAS_S3_BUCKET=my-mas-bucket
# MAS_S3_ACCESS_KEY_ID=
# MAS_S3_SECRET_ACCESS_KEY=
# MAS_S3_PREFIX=mas/
# MAS_S3_ADDRESSING_STYLE=virtual                     # virtual | path (برای MinIO: path)

# ── سهمیه‌ها ────────────────────────────────────────────────
MAS_MAX_UPLOAD_MB=50
MAS_MAX_ROOM_STORAGE_MB=2048
MAS_MAX_USER_STORAGE_MB=10240
MAS_MAX_ROOMS_PER_USER=50
MAS_MAX_ROOM_CAPACITY=100
MAS_MAX_RECORDING_MINUTES=180
MAS_RECORDING_BITRATE_KBPS=32
MAS_RECORDING_CHUNK_SECONDS=5

# ── نشست کاربر ──────────────────────────────────────────────
MAS_SESSION_IDLE_MINUTES=720
MAS_SESSION_ABSOLUTE_DAYS=30
MAS_COOKIE_SECURE=0

# ── محدودسازی نرخ ───────────────────────────────────────────
# تعداد پرش‌های قابل‌اعتماد در X-Forwarded-For (روی Render معمولاً 1).
# 0 یعنی هدر نادیده گرفته شود و IP سوکت استفاده شود.
MAS_TRUSTED_PROXY_HOPS=1
MAS_LOGIN_MAX_ATTEMPTS=10
MAS_LOGIN_WINDOW_SECONDS=600
MAS_REGISTER_MAX_PER_IP=20
MAS_REGISTER_WINDOW_SECONDS=3600

# ── اتاق عمومی ─────────────────────────────────────────────
MAS_PUBLIC_STATE_MAX_AGE_SECONDS=2

# ── مدیر ────────────────────────────────────────────────────
# اگر این نام کاربری وجود داشته باشد، در شروع برنامه نقش admin می‌گیرد.
# MAS_BOOTSTRAP_ADMIN_USERNAME=

# ── آدرس عمومی (اختیاری) ───────────────────────────────────
# فقط اگر برنامه پشت پروکسی با دامنهٔ متفاوت است؛ در غیر این صورت از origin مرورگر استفاده می‌شود.
# MAS_PUBLIC_BASE_URL=https://mas-xyrb.onrender.com
