# Local development only. Never commit a populated .env file.
MAS_ENV=development
MAS_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
MAS_DATABASE_URL=sqlite:///./mas.db
MAS_STORAGE_BACKEND=local
MAS_STORAGE_DIR=./uploads
MAS_COOKIE_SECURE=false
MAS_PUBLIC_BASE_URL=http://localhost:8000
MAS_RUN_MIGRATIONS_ON_STARTUP=true

# For production, set DATABASE_URL to your existing PostgreSQL database and
# provide MAS_SECRET_KEY through the hosting platform's secret manager.
# Keep the same database URL, secret key, and persistent storage when upgrading.

# Optional S3-compatible storage (install requirements-s3.txt first):
# MAS_STORAGE_BACKEND=s3
# MAS_S3_ENDPOINT_URL=https://s3.example.com
# MAS_S3_REGION=us-east-1
# MAS_S3_BUCKET=your-bucket
# MAS_S3_ACCESS_KEY_ID=your-access-key
# MAS_S3_SECRET_ACCESS_KEY=your-secret-key
# MAS_S3_PREFIX=mas/
# MAS_S3_ADDRESSING_STYLE=path
# MAS_S3_USE_PRESIGNED_DOWNLOAD=false
