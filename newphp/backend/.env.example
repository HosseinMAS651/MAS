# ── نمونهٔ تنظیمات MAS (نسخهٔ PHP/Laravel) ──────────────────────────────
# این فایل را به .env کپی و مقادیر را تنظیم کنید. در Docker Compose بیشتر
# مقادیر از خود compose تزریق می‌شوند.

APP_NAME=MAS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── دیتابیس (PostgreSQL در Docker؛ sqlite فقط برای تست‌های phpunit) ─────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mas
DB_USERNAME=mas
DB_PASSWORD=change-me

# واکنش‌ها (reactions) بین پردازه‌های PHP-FPM با Redis اشتراک گذاشته می‌شوند.
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── MAS ────────────────────────────────────────────────────────────────
MAS_ENV=production
# کلید HMAC توکن‌های نشست/کد سخنران؛ در production الزامی و حداقل ۳۲ نویسه.
MAS_SECRET_KEY=
MAS_PUBLIC_BASE_URL=
MAS_LOG_LEVEL=INFO

# ذخیره‌سازی: local | s3
MAS_STORAGE_BACKEND=local
MAS_STORAGE_DIR=/var/www/html/storage/app/uploads
# MAS_S3_BUCKET=
# MAS_S3_REGION=us-east-1
# MAS_S3_ENDPOINT_URL=
# MAS_S3_ACCESS_KEY_ID=
# MAS_S3_SECRET_ACCESS_KEY=
# MAS_S3_PREFIX=mas/
# MAS_S3_USE_PRESIGNED_DOWNLOAD=false

# کوکی نشست — پشت HTTPS حتماً MAS_COOKIE_SECURE=true باشد.
MAS_COOKIE_SECURE=false
MAS_COOKIE_SAMESITE=lax
MAS_TRUSTED_PROXY_HOPS=1
